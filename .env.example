# 默认 MOCK：本地开发会走完整订单接口，但不会发生真实扣款。
PAYMENT_MODE=MOCK

# 开启真实微信支付时改为 WECHAT，并填写下列全部参数。
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_PAY_MERCHANT_ID=
WECHAT_PAY_MERCHANT_SERIAL_NUMBER=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_NOTIFY_URL=https://api.example.com/api/payment/wechat/notify

# AI 私厨服务（生产环境必须设置高强度随机服务令牌）
AI_CHEF_BASE_URL=http://host.docker.internal:8081
CLOUD_MEAL_AI_SERVICE_TOKEN=
AI_CHEF_CONNECT_TIMEOUT_MS=3000
AI_CHEF_READ_TIMEOUT_MS=70000
